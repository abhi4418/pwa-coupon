# Local dev: copy to .env (localServer.mjs reads these; Vercel reads dashboard env vars)
# STEEL_API_KEY=ste-...               # Steel cloud browser (used first when set). Get one at app.steel.dev/settings/api-keys
# BROWSER_WS_URL=wss://...            # generic remote CDP fallback (Browserbase / Browserless). Empty = local Chrome.
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
# PORT=8080
